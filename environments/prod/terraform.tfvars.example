# name: Raul Pena (raul.pena@gmail.com)
# createAt: 2026-08-02T17:53:34-0300
# Description: Example Terraform variable values for the prod environment.

aws_region          = "us-east-1"
project             = "blueprint"
environment         = "prod"
owner               = "platform"
cost_center         = "platform"
data_classification = "confidential"
vpc_cidr            = "10.30.0.0/16"
az_count            = 3
enable_nat_gateway  = true
single_nat_gateway  = false
enable_s3_endpoint  = true

rds_instance_class               = "db.t4g.medium"
rds_allocated_storage            = 50
rds_max_allocated_storage        = 500
rds_multi_az                     = true
rds_backup_retention_period      = 7
rds_deletion_protection          = true
rds_skip_final_snapshot          = false
rds_performance_insights_enabled = true

valkey_engine_version              = "7.2"
valkey_node_type                   = "cache.t4g.medium"
valkey_num_cache_clusters          = 2
valkey_automatic_failover_enabled  = true
valkey_multi_az_enabled            = true
valkey_snapshot_retention_limit    = 7
valkey_snapshot_window             = "03:00-04:00"
valkey_maintenance_window          = "sun:04:00-sun:05:00"
valkey_apply_immediately           = false
valkey_transit_encryption_enabled  = true
valkey_auto_minor_version_upgrade  = true
